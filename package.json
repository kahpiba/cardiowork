{
  "name": "cardiowork-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CardioWork — Sistem Terpadu Prediksi Risiko Kardiovaskular Pekerja (MCU + DCU) Berbasis Edge AI & Serverless Vercel",
  "scripts": {
    "dev": "pnpm --filter @cardiowork/web dev",
    "build": "pnpm --filter @cardiowork/shared build && pnpm --filter @cardiowork/web build",
    "lint": "pnpm --filter @cardiowork/web lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --filter @cardiowork/web test",
    "test:ml": "cd ml && pytest",
    "db:generate": "pnpm --filter @cardiowork/web db:generate",
    "db:migrate": "pnpm --filter @cardiowork/web db:migrate",
    "db:studio": "pnpm --filter @cardiowork/web db:studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.7.0"
}
