{
  "contract_version": "1.0.0",
  "project": "CardioWork",
  "last_updated": "2026-09-28",
  "description": "Single Source of Truth untuk spesifikasi fitur klinis MCU, DCU, dan rekayasa fitur bersama antara TypeScript dan Python.",
  
  "mcu_features": {
    "age": {
      "type": "integer",
      "unit": "years",
      "min_valid": 18,
      "max_valid": 75,
      "imputation": "median",
      "default_impute_value": 38,
      "scaling": { "type": "standard", "mean": 38.5, "std": 9.2 }
    },
    "gender": {
      "type": "categorical",
      "unit": "enum",
      "categories": ["MALE", "FEMALE"],
      "encoding": { "MALE": 1, "FEMALE": 0 }
    },
    "bmi": {
      "type": "float",
      "unit": "kg/m2",
      "min_valid": 14.0,
      "max_valid": 55.0,
      "imputation": "median",
      "default_impute_value": 25.4,
      "scaling": { "type": "standard", "mean": 25.8, "std": 4.1 }
    },
    "systolic_bp": {
      "type": "integer",
      "unit": "mmHg",
      "min_valid": 70,
      "max_valid": 250,
      "imputation": "median",
      "default_impute_value": 120,
      "scaling": { "type": "standard", "mean": 124.5, "std": 14.8 }
    },
    "diastolic_bp": {
      "type": "integer",
      "unit": "mmHg",
      "min_valid": 40,
      "max_valid": 150,
      "imputation": "median",
      "default_impute_value": 80,
      "scaling": { "type": "standard", "mean": 80.2, "std": 9.5 }
    },
    "resting_heart_rate": {
      "type": "integer",
      "unit": "bpm",
      "min_valid": 40,
      "max_valid": 160,
      "imputation": "median",
      "default_impute_value": 72,
      "scaling": { "type": "standard", "mean": 72.4, "std": 8.6 }
    },
    "fasting_glucose": {
      "type": "float",
      "unit": "mg/dL",
      "min_valid": 50.0,
      "max_valid": 450.0,
      "imputation": "median",
      "default_impute_value": 95.0,
      "scaling": { "type": "standard", "mean": 96.2, "std": 22.4 }
    },
    "total_cholesterol": {
      "type": "float",
      "unit": "mg/dL",
      "min_valid": 80.0,
      "max_valid": 500.0,
      "imputation": "median",
      "default_impute_value": 190.0,
      "scaling": { "type": "standard", "mean": 195.4, "std": 32.1 }
    },
    "hdl_cholesterol": {
      "type": "float",
      "unit": "mg/dL",
      "min_valid": 15.0,
      "max_valid": 120.0,
      "imputation": "median",
      "default_impute_value": 48.0,
      "scaling": { "type": "standard", "mean": 48.6, "std": 10.2 }
    },
    "ldl_cholesterol": {
      "type": "float",
      "unit": "mg/dL",
      "min_valid": 30.0,
      "max_valid": 350.0,
      "imputation": "median",
      "default_impute_value": 115.0,
      "scaling": { "type": "standard", "mean": 118.2, "std": 28.5 }
    },
    "triglycerides": {
      "type": "float",
      "unit": "mg/dL",
      "min_valid": 30.0,
      "max_valid": 800.0,
      "imputation": "median",
      "default_impute_value": 140.0,
      "scaling": { "type": "standard", "mean": 142.0, "std": 48.0 }
    },
    "smoking_status": {
      "type": "categorical",
      "unit": "enum",
      "categories": ["NON_SMOKER", "FORMER_SMOKER", "ACTIVE_SMOKER"],
      "encoding": { "NON_SMOKER": 0, "FORMER_SMOKER": 1, "ACTIVE_SMOKER": 2 }
    },
    "resting_ecg": {
      "type": "categorical",
      "unit": "enum",
      "categories": ["NORMAL", "BORDERLINE", "ABNORMAL"],
      "encoding": { "NORMAL": 0, "BORDERLINE": 1, "ABNORMAL": 2 }
    }
  },

  "dcu_features": {
    "systolic_bp": {
      "type": "integer",
      "unit": "mmHg",
      "min_valid": 70,
      "max_valid": 250
    },
    "diastolic_bp": {
      "type": "integer",
      "unit": "mmHg",
      "min_valid": 40,
      "max_valid": 150
    },
    "resting_heart_rate": {
      "type": "integer",
      "unit": "bpm",
      "min_valid": 40,
      "max_valid": 160
    },
    "spo2_percent": {
      "type": "integer",
      "unit": "percent",
      "min_valid": 80,
      "max_valid": 100
    },
    "body_temperature_c": {
      "type": "float",
      "unit": "celsius",
      "min_valid": 35.0,
      "max_valid": 42.0
    },
    "sleep_hours_last_24h": {
      "type": "float",
      "unit": "hours",
      "min_valid": 0.0,
      "max_valid": 18.0
    },
    "reaction_time_ms": {
      "type": "integer",
      "unit": "milliseconds",
      "min_valid": 100,
      "max_valid": 1000
    }
  },

  "derived_features": {
    "pulse_pressure": "systolic_bp - diastolic_bp",
    "mean_arterial_pressure": "diastolic_bp + (1/3) * (systolic_bp - diastolic_bp)",
    "cholesterol_hdl_ratio": "total_cholesterol / hdl_cholesterol",
    "triglycerides_hdl_ratio": "triglycerides / hdl_cholesterol"
  },

  "alert_thresholds": {
    "critical_systolic_bp": 180,
    "critical_diastolic_bp": 120,
    "critical_spo2_low": 92,
    "critical_heart_rate_high": 120,
    "critical_heart_rate_low": 45,
    "warning_systolic_bp": 140,
    "warning_diastolic_bp": 90,
    "warning_sleep_hours_low": 5.0
  }
}
