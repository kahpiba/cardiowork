# ==============================================================================
# CARDIOWORK — CONTOH VARIABEL LINGKUNGAN (.env.example)
# Salin berkas ini ke `.env` untuk konfigurasi lokal.
# JANGAN PERNAH MENYIMPAN NILAI RAHASIA NYATA DI SINI ATAU DI REPOSITORI GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IDENTITAS APLIKASI & LINGKUNGAN
# ------------------------------------------------------------------------------
NODE_ENV="development" # development | production | test
APP_ENV="local"        # local | preview | production
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CardioWork"
NEXT_PUBLIC_DEMO_MODE="true" # Menampilkan banner DATA SINTETIS — BUKAN BUKTI KLINIS

# ------------------------------------------------------------------------------
# 2. BASIS DATA (Serverless Postgres - Neon / Supabase)
# ------------------------------------------------------------------------------
# URL koneksi Postgres dengan pooler (wajib untuk fungsi serverless Vercel)
DATABASE_URL="postgresql://cardiowork_user:cardiowork_password@ep-sample-12345.ap-southeast-1.aws.neon.tech/cardiowork?sslmode=require"
# URL koneksi langsung (hanya digunakan saat migrasi schema / Drizzle migration)
DATABASE_URL_UNPOOLED="postgresql://cardiowork_user:cardiowork_password@ep-sample-12345.ap-southeast-1.aws.neon.tech/cardiowork?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTENTIKASI (Auth.js v5 / NextAuth)
# ------------------------------------------------------------------------------
# Secret enkripsi token JWT sesi (generate dengan `openssl rand -base64 32`)
AUTH_SECRET="your-32-character-random-secret-key-goes-here-min-32-chars"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000/api/auth"

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & CACHE (Upstash Redis HTTP Serverless)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://sample-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="sample-upstash-redis-rest-token-here"

# ------------------------------------------------------------------------------
# 5. BERKAS & PENYIMPANAN BLOB (Vercel Blob Private Storage)
# ------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token_here"

# ------------------------------------------------------------------------------
# 6. MODE INFERENSI KECERDASAN BUATAN (INFERENCE_MODE)
# ------------------------------------------------------------------------------
# Pilihan: onnx-node (Default serverless Vercel) | browser (WASM Client-side) | remote (FastAPI)
INFERENCE_MODE="onnx-node"
REMOTE_INFERENCE_URL="https://cardiowork-inference-api.up.railway.app/predict"
REMOTE_INFERENCE_API_KEY="optional-bearer-api-key-for-remote-inference"

# ------------------------------------------------------------------------------
# 7. VERCEL CRON JOBS SECRET
# ------------------------------------------------------------------------------
# Token verifikasi untuk mengamankan route /api/cron/* dari eksekusi ilegal
CRON_SECRET="your-high-entropy-cron-secret-token"

# ------------------------------------------------------------------------------
# 8. ENKRIPSI FIELD LEVEL REKAM MEDIS (UU PDP No. 27/2022)
# ------------------------------------------------------------------------------
# Kunci simetris AES-256-GCM (32 bytes heksadesimal) untuk kolom catatan dokter
CLINICAL_FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
