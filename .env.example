# ==============================================================================
# CardioWork - Occupational Cardiovascular CDSS
# Root Environment Variables Configuration (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SERVERLESS POSTGRES (Neon / Supabase / Local Docker)
# ------------------------------------------------------------------------------
# Connection string with pooled connection (pgbouncer/transaction pooling)
DATABASE_URL="postgresql://cardiowork_user:cardiowork_password@ep-cool-project-123456.ap-southeast-1.aws.neon.tech/cardiowork?sslmode=require&pgbouncer=true"

# Direct connection string for schema migrations (Prisma / Drizzle)
DIRECT_URL="postgresql://cardiowork_user:cardiowork_password@ep-cool-project-123456.ap-southeast-1.aws.neon.tech/cardiowork?sslmode=require"

# ------------------------------------------------------------------------------
# 2. CACHING & RATE LIMITING (Upstash Redis / Redis Cloud)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://ap1-humble-mammal-12345.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AY12ASQgMDcyMWJmYWEtMWQ5Yi00YzU0LTk0ZjEtMGIyMmZkMmRiNzhl"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (NextAuth.js / Auth.js)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="k3_c@rd10w0rk_sup3r_s3cur3_pr0duct10n_k3y_32b_hex_demo"
NEXTAUTH_URL="http://localhost:3000"

# Application public base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Mode Flag (enables pre-seeded synthetic workers WRK-0001 to WRK-1000)
NEXT_PUBLIC_DEMO_MODE="true"

# ------------------------------------------------------------------------------
# 4. INFERENCE ENGINE & MODEL CONFIGURATION
# ------------------------------------------------------------------------------
# Options: 'onnx-node' (Vercel Serverless with onnxruntime-node) | 'calibrated-ts' (Pure TS fallback)
INFERENCE_MODE="onnx-node"

# ONNX Model Artifact Paths (Relative to apps/web/public/models or absolute)
MODEL_PATH_CLASSICAL="public/models/classical_ml_model.onnx"
MODEL_PATH_FUSION="public/models/multimodal_fusion.onnx"
MODEL_PATH_AUTOENCODER="public/models/autoencoder_anomaly.onnx"

# ------------------------------------------------------------------------------
# 5. PRIVACY & COMPLIANCE (UU No. 27/2022 & Permenkes No. 24/2022)
# ------------------------------------------------------------------------------
# Minimum cell count for aggregate health dashboard suppression (Default: 5)
POPULATION_SUPPRESSION_THRESHOLD="5"

# Cryptographic salt for worker pseudonymization hashing
PSEUDONYM_HASH_SALT="cardiowork_salt_k3_occupational_health_2026"

# Audit Log Level: 'ERROR' | 'WARN' | 'INFO' | 'DEBUG'
AUDIT_LOG_LEVEL="INFO"
